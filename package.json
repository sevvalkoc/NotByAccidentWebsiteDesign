{
  "name": "notbyaccident-next",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Not by Accident — website, next direction. Prerendered React.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "snapshot": "node --experimental-strip-types --no-warnings scripts/cms-snapshot.ts",
    "build:client": "vite build --outDir dist/client",
    "build:server": "vite build --ssr src/entry-server.tsx --outDir dist/server",
    "build": "pnpm carbon && pnpm snapshot && pnpm build:client && pnpm build:server && node scripts/prerender.mjs",
    "preview": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "qa": "node scripts/qa.mjs",
    "carbon": "node scripts/carbon-factor.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource-variable/lora": "^5.2.8",
    "@supabase/supabase-js": "^2.49.8",
    "pdf-lib": "1.17.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@tgwf/co2": "^0.19.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.0.0",
    "axe-core": "4.10.3",
    "playwright": "^1.55.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.0"
  },
  "engines": {
    "node": "22.x"
  }
}
